{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campshare-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Cloudflare D1 database — replace database_id after running:
  //   wrangler d1 create campshare-db
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campshare-db",
      "database_id": "a1a0059a-fdac-4f2b-858f-b8d563728d67"
    }
  ],

  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "campshare-photos" }
  ],

  "vars": {
    "BETTER_AUTH_URL": "https://app.campshare.co.nz",
    "ADMIN_EMAIL": "jontydavies7@gmail.com",
    "NEXT_PUBLIC_R2_PUBLIC_URL": "https://pub-4433449fb7ff44d2b0ecb6d7e21faafa.r2.dev",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_51TZ1CtL0Mn9hYRhmN0PBuIp31pa59AZ1zckkmeHxECKRFpgDsKUS1xSpQgJNQ2tutULhq9kMukjU0Ihz50ux78iK00Qk67U4cp",
    "NEXT_PUBLIC_MAPBOX_TOKEN": "pk.eyJ1Ijoiam9udHlkNyIsImEiOiJjbXBlNHJzdTkwMGlxMnJvam04ZGV5M3J5In0.d2qPJyXlFxIAfu0h6Jflcw",
    // Turnstile site key (public — safe to commit). Secret key goes in: wrangler secret put TURNSTILE_SECRET_KEY
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAADUHciCF9p7f_62D"
  },

  // Rate limiters: 10 auth attempts / 60s per IP; 5 booking attempts / 60s per user
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMIT_AUTH",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "RATE_LIMIT_BOOKINGS",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  },

  "triggers": {
    "crons": ["0 0 * * *"]
  },

  "routes": [
    {
      "pattern": "app.campshare.co.nz",
      "custom_domain": true
    }
  ]
}
