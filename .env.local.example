# ------------------------------------------------------------------
# CampShare App — environment variables
# Copy this file to .env.local and fill in real values.
# ------------------------------------------------------------------

# Better Auth
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of this app
# Dev: http://localhost:3000
# Prod: https://app.campshare.co.nz
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (transactional email) — already provisioned for marketing site
RESEND_API_KEY=

# Admin (hardcoded default, override if needed)
ADMIN_EMAIL=jontydavies7@gmail.com

# From address used for outbound email
EMAIL_FROM="CampShare <hello@campshare.co.nz>"
